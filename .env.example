# ==============================================================================
# FRONTEND VARIABLES (Publicly safe to expose in React build)
# ==============================================================================
# The URL to your Supabase project (e.g. https://xyz.supabase.co)
VITE_SUPABASE_URL=your_project_url

# The public anon key for your Supabase project
VITE_SUPABASE_ANON_KEY=your_anon_key

# The URL of your FastAPI backend (e.g. http://localhost:8000 for local, or https://api.domain.com for production)
VITE_API_BASE_URL=http://localhost:8000

# ==============================================================================
# BACKEND VARIABLES (SECRET - Never expose to frontend or commit to Git)
# ==============================================================================
# The URL to your Supabase project (same as frontend)
SUPABASE_URL=your_project_url

# The highly privileged service role key for backend database bypass
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# The URL of your deployed frontend (used for CORS configuration)
FRONTEND_ORIGIN=http://localhost:5173

# (Optional) Model Path Overrides
# WATERLOGGING_MODEL_PATH=/app/weights/waterlogging.pt
# POTHOLE_MODEL_PATH=/app/weights/pothole.pt
